/backups/
*.bak
*.backup

# Generated reports and documents
*.log
*.tmp

# Test and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE settings
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Build and distribution
build/
dist/
*.egg-info/

# Node-related generated files, if any
node_modules/
